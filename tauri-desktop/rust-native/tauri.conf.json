{
  "$schema": "../react-ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ReadyType",
  "version": "0.1.0",
  "identifier": "com.readytype",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../react-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReadyType",
        "hiddenTitle": true,
        "titleBarStyle": "Transparent",
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/app-icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMjMzRUJCRTkwQjUzMTYKUldRV1V3dnB1ejRqb2RWUVozRkxCckhFZVJpMHFHREVyOE5Oc0ZMcE9OdUxHcWYzNWp3SnVNTTMK",
      "endpoints": [
        "https://github.com/riku1021/ReadyType/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
