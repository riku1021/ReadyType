{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadyType",
  "version": "0.1.0",
  "identifier": "com.readytype",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../react-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReadyType",
        "hiddenTitle": true,
        "titleBarStyle": "Transparent",
        "visible": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
