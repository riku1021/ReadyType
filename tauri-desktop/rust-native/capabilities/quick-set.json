{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-set",
  "description": "Capability for the Level-1 Quick Set popover window",
  "windows": ["quick-set"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:event:default",
    "allow-input-source-switcher",
    "allow-sync-window-chrome-theme"
  ]
}
