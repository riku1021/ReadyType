---
import Button from "@/components/Button/Button.astro";
import Logo from "@/components/Logo/Logo.astro";
import { navItems, sideNavItems } from "@/content/landing";
import { wrap } from "@/styles/objects/layout.styles";
import { header, menuButton, mobileNav, nav, navLink, navList } from "./SiteHeader.styles";
---

<header class={header} data-header>
  <div class:list={[wrap, nav]}>
    <Logo />
    <ul class={navList}>
      {navItems.map((item) => (
        <li><a class={navLink} href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <Button href="#download" size="nav" desktopDownload>ダウンロード</Button>
    <button
      class={menuButton}
      id="menuBtn"
      type="button"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mnav"
    ><i></i></button>
  </div>
  <nav class={mobileNav} id="mnav" aria-label="メインメニュー">
    {sideNavItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
</header>
