---
import { button } from "./Button.styles";

interface Props {
  href: string;
  variant?: "main" | "sub" | "white";
  size?: "md" | "nav";
  /** クリックで、判定した OS のインストーラへ進む */
  desktopDownload?: boolean;
}

const { href, variant = "main", size = "md", desktopDownload = false } = Astro.props;
---

<a
  href={href}
  class={button({ variant, size })}
  data-download={desktopDownload ? "primary" : undefined}
><slot /></a>
