---
import Glyph from "@/components/Glyph/Glyph.astro";
import SectionIntro from "@/components/SectionIntro/SectionIntro.astro";
import { caret } from "@/styles/objects/caret.styles";
import { section, wrap } from "@/styles/objects/layout.styles";
import { reveal, tilt } from "@/styles/objects/motion.styles";
import {
  bad,
  card,
  cards,
  cardTitle,
  highlight,
  miss,
  problem,
  punch,
  punchChar,
  punchLead,
  punchMark,
  typed,
} from "./Problem.styles";

const retryChars = [..."打ち直していませんか？"];
---

<section class:list={[section, problem]} id="problem">
  <div class={wrap}>
    <SectionIntro
      kicker="PROBLEM"
      title="こんな経験、ありませんか？"
      lead="たった一瞬のことなのに、1日に何度も起きるから、地味にストレス。"
    />
    <div class={cards}>
      <div class:list={[card, tilt, reveal]} data-reveal data-stagger data-tilt>
        <h3 class={cardTitle}><Glyph name="lucide:message-circle" /> 日本語を入力したいのに…</h3>
        <div class={bad}><span class={typed} style="--w: 10.5ch">konnichiwa</span><span class={caret()}></span></div>
        <p><span class={miss}><Glyph name="lucide:x" /></span> 英語のままで、打ち直し</p>
      </div>
      <div class:list={[card, tilt, reveal]} data-reveal data-stagger data-tilt>
        <h3 class={cardTitle}><Glyph name="lucide:code" /> 英語を入力したいのに…</h3>
        <div class={bad}><span class={typed} style="--w: 6.5ch">こんst</span><span class={caret()}></span></div>
        <p><span class={miss}><Glyph name="lucide:x" /></span> 日本語のままで、変換候補が出てくる</p>
      </div>
    </div>
    <p class={punch}>
      <span class:list={[punchLead, reveal]} data-reveal data-stagger>毎回、入力ソースを切り替えて、</span>
      <b class={punchMark} data-reveal><span class={highlight}>{retryChars.map((char, index) => <span class={punchChar} style={`--char-index: ${index}`}>{char}</span>)}</span></b>
    </p>
  </div>
</section>
