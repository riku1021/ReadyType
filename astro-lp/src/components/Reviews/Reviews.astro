---
import { reviews } from "../../content/landing";
import { section, wrap } from "../../styles/objects/layout.styles";
import { reveal } from "../../styles/objects/motion.styles";
import SectionIntro from "../SectionIntro/SectionIntro.astro";
import { card, grid } from "./Reviews.styles";
---

<section class={section} id="review">
  <div class={wrap}>
    <SectionIntro kicker="REVIEW" lead="ここにレビューの説明文を入れてください。">ご利用者の声</SectionIntro>
    <div class={grid}>
      {reviews.map((text) => (
        <div class:list={[card, reveal]} data-reveal data-stagger>{text}</div>
      ))}
    </div>
  </div>
</section>
