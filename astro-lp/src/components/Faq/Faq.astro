---
import SectionIntro from "@/components/SectionIntro/SectionIntro.astro";
import { faqs } from "@/content/landing";
import { sectionFlush, wrap } from "@/styles/objects/layout.styles";
import { reveal } from "@/styles/objects/motion.styles";
import { answer, answerBody, item, list, mark, summary } from "./Faq.styles";
---

<section class={sectionFlush} id="faq">
  <div class={wrap}>
    <SectionIntro kicker="FAQ" lead="導入の前に、気になる点をまとめました。">よくある質問</SectionIntro>
    <div class={list}>
      {faqs.map((faq) => (
        <details class:list={[item, reveal]} data-reveal data-stagger>
          <summary class={summary}>
            {faq.q}
            <span class={mark} aria-hidden="true"></span>
          </summary>
          <div class={answer}>
            <p class={answerBody}>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
