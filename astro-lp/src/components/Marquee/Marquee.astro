---
import Glyph from "@/components/Glyph/Glyph.astro";
import { chip, chipMark, marquee, row, track } from "./Marquee.styles";

const chips = [
  { tone: "brand", mark: "あ", label: "フォーカスするだけで自動切り替え" },
  { tone: "accent", mark: "A", label: "アプリ単位ではなく入力欄単位" },
  { tone: "gold", icon: "lucide:zap", label: "高速に、確実に切り替え" },
  { tone: "success", icon: "lucide:lock", label: "入力内容は読み取らない" },
  { tone: "brand", icon: "lucide:keyboard", label: "打ち直しは、もう不要。" },
  { tone: "accent", icon: "lucide:target", label: "入力欄ごとにルール設定" },
] as const;

const loop = [0, 1] as const;
---

<div class={marquee} aria-hidden="true">
  <div class={row}>
    <div class={track}>
      {loop.map(() =>
        chips.map((item) => (
          <span class={chip}>
            <i class={chipMark({ tone: item.tone })}>
              {"icon" in item ? <Glyph name={item.icon} /> : item.mark}
            </i>
            {item.label}
          </span>
        )),
      )}
    </div>
  </div>
</div>
