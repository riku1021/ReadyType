---
import Glyph from "@/components/Glyph/Glyph.astro";
import { wrap } from "@/styles/objects/layout.styles";
import { eyebrow, howGrad } from "@/styles/objects/type.styles";
import {
  badge,
  badgeEn,
  badgeJa,
  badgeLabel,
  badgeMark,
  base,
  bubble,
  caret,
  column,
  columnCode,
  columnTitle,
  cursor,
  cursorRing,
  display,
  draft,
  field,
  grid,
  how,
  ime,
  imeEn,
  imeJa,
  keyword,
  laptop,
  lead,
  lid,
  menu,
  menuGrow,
  ring,
  ringDone,
  scan,
  scanLabel,
  screenScale,
  shadow,
  source,
  stage,
  status,
  statusText,
  step,
  steps,
  stepText,
  stepTitle,
  stick,
  title,
  toast,
  track,
  typed,
  workspace,
} from "./HowItWorks.styles";

const flow = [
  {
    icon: "lucide:mouse",
    title: "入力欄を選ぶ",
    text: "チャットでもエディタでも、いつも通りクリックするだけ。",
  },
  {
    icon: "lucide:search",
    title: "種類を見分ける",
    text: "ReadyTypeが、どんな入力欄かを判定します。",
  },
  {
    icon: "lucide:arrow-left-right",
    title: "自動で切り替える",
    text: "最適な入力ソースに切り替わり、そのまま入力できます。",
  },
] as const;
---

<section class={how} id="how" data-step="0">
  <div class={track} data-how-track>
    <div class={stick} data-how-stick>
      <div class:list={[wrap, grid]}>
        <div>
          <span class={eyebrow({ tone: "onDark" })}>HOW IT WORKS</span>
          <h2 class={title}>やることは、<span class={howGrad}>入力欄を選ぶだけ。</span></h2>
          <p class={lead}>アプリが入力欄の種類を見分け、入力ソースを切り替えます。スクロールすると、流れを順に確認できます。</p>
          <ol class={steps}>
            {flow.map((item, index) => (
              <li class={step} tabindex="0" data-how-step data-state={index === 0 ? "cur" : undefined}>
                <span class={ring}><Glyph name={item.icon} /><span class={ringDone}><Glyph name="lucide:check" /></span></span>
                <div>
                  <h3 class={stepTitle}>{item.title}</h3>
                  <p class={stepText}>{item.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class={stage}>
          <div class={laptop} aria-hidden="true">
            <div class={lid}>
              <div class={display}>
                <div class={screenScale}>
                <div class={menu}><span>Cursor</span><i class={menuGrow}></i><b class={ime}><span class={imeEn}>A</span><span class={imeJa}>あ</span></b></div>
                <div class={toast}>日本語に自動で切り替え</div>
                <div class={workspace}>
                  <div class={column}>
                    <div class={columnTitle}><Glyph name="lucide:message-circle" /> Chat</div>
                    <div class={bubble}>このコードについて説明してください。</div>
                    <div class={field}>
                      <span class={draft}>メッセージを送信…</span><span class={typed}>こんにちは</span><span class={caret}></span>
                      <div class={scan}><em class={scanLabel}><Glyph name="lucide:search" /> チャット欄を検出</em></div>
                    </div>
                  </div>
                  <div class:list={[column, columnCode]}>
                    <div class={columnTitle}>&lt;/&gt; main.ts</div>
                    <pre class={source}><span class={keyword}>function</span> greet(name) {"{"}
  <span class={keyword}>return</span> `Hello, ${"{"}name{"}"}`;
{"}"}</pre>
                  </div>
                </div>
                <div class={cursor}>
                  <svg viewBox="0 0 24 24" width="100%" height="100%" aria-hidden="true">
                    <path d="M4 2l16 9-7 2-3 7z" fill="#fff" stroke="#0F1B3D" stroke-width="1.6" stroke-linejoin="round"></path>
                  </svg>
                  <s class={cursorRing}></s>
                </div>
                <div class={status}>
                  <span class={statusText} data-at="0">① 入力欄をクリック</span>
                  <span class={statusText} data-at="1">② 種類を判定中…</span>
                  <span class={statusText} data-at="2">③ 日本語に切り替え完了</span>
                </div>
                </div>
              </div>
            </div>
            <div class={base}></div>
            <div class={shadow}></div>
            <div class:list={[badge, badgeJa]}><b class={badgeMark}>あ</b><small class={badgeLabel}>日本語</small></div>
            <div class:list={[badge, badgeEn]}><b class={badgeMark}>A</b><small class={badgeLabel}>英語</small></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
